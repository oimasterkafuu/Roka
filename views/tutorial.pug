html
  head
    meta(charset='utf-8')
    link(rel='icon', href='/icons/favicon.ico?v={{V}}', sizes='any')
    link(rel='icon', type='image/png', sizes='32x32', href='/icons/icon-32.png?v={{V}}')
    link(rel='icon', type='image/png', sizes='192x192', href='/icons/icon-192.png?v={{V}}')
    link(rel='apple-touch-icon', href='/icons/icon-180.png?v={{V}}')
    meta(
      name='viewport',
      content='width=device-width, height=device-height, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes'
    )
    link(rel='stylesheet', href='/main.css?v={{V}}')
    link(rel='stylesheet', href='/styles/tutorial.css?v={{V}}')
    title Roka - 互动教程
  body
    div#game
      div#map
      div#map_back
    div#turn-counter
    table#game-leaderboard
      tbody
    div#tutorial-top-left
      button#room-home-btn.small 返回首页
      button#tutorial-reset-btn.small 重置
      a.tutorial-back-link(href='/tutorial') ← 返回文字版教程
    div#tutorial-step-banner.background
      p#tutorial-step-progress
      p#tutorial-step-title
      p#tutorial-step-body
      p#tutorial-step-hint
      button#tutorial-next-btn.small(type='button', style='display: none') 继续
    script(src='/main/blink-clock.js?v={{V}}')
    script(src='/tutorial.js?v={{V}}')
