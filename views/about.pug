extends layout.pug

block vars
  - var bodyStyle = 'overflow: auto; height: auto'
  - var currentPage = 'about'

block head
  link(rel='stylesheet', href='/styles/docs.css?v={{V}}')
  link(rel='stylesheet', href='/styles/intro.css?v={{V}}')
  link(rel='stylesheet', href='/styles/rating.css?v={{V}}')
  script(defer, src='/intro.js?v={{V}}', data-version='{{V}}')
  style.
    .contributors-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(160px, 100%), 1fr));
      gap: 12px;
      margin-top: 14px;
    }
    .contributor-card {
      min-width: 0;
      border: 1px solid #e3e8f0;
      border-radius: 8px;
      background: #f7f9fb;
    }
    .contributor-link {
      display: grid;
      min-width: 0;
      grid-template-columns: 64px minmax(0, 1fr);
      align-items: center;
      gap: 4px 10px;
      padding: 12px;
      color: #253042;
      text-decoration: none;
    }
    .contributor-link img {
      width: 64px;
      height: 64px;
      grid-row: 1 / span 2;
      border-radius: 50%;
      background: #e3e8f0;
    }
    .contributor-name {
      min-width: 0;
      align-self: end;
      overflow-wrap: anywhere;
      font-family: Quicksand-Bold, HYMaQiDuo-Bold;
    }
    .contributor-count {
      display: block;
      align-self: start;
      color: #5c6675;
      font-size: 13px;
    }
    .contributor-roka-link {
      display: block;
      padding: 0 12px 12px;
      color: teal;
      font-size: 13px;
      overflow-wrap: anywhere;
      text-decoration: none;
    }
    .contributor-roka-link:hover {
      text-decoration: underline;
    }
    #contributors-status,
    #stargazers-status {
      margin-top: 10px;
      color: #5c6675;
    }
    .contributors-github-link {
      margin-top: 12px;
      font-size: 14px;
    }
    @media (max-width: 640px) {
      .contributors-grid {
        grid-template-columns: repeat(auto-fit, minmax(min(140px, 100%), 1fr));
        gap: 8px;
      }
      .contributor-link {
        grid-template-columns: 48px minmax(0, 1fr);
        gap: 4px 8px;
        padding: 10px;
      }
      .contributor-link img {
        width: 48px;
        height: 48px;
      }
    }
  title Roka - 关于

block content
  #app
    h1.doc-title 关于 Roka
    p.doc-subtitle Roka 是一个多人策略对战项目：自定义房间、实时对局、回放与账号系统，在 generals.io 玩法基础上做了适配与扩展。本项目不是官方 generals.io 服务。
    section.doc-panel
      h2 游戏介绍片
      p 两分钟走进 Roka 的方格战场。由浏览器实时绘制，包含音乐，可暂停、静音或跳过。
      .cta-row
        button.small.inverted(type='button', data-intro-replay) 重播游戏介绍片 →
    section.doc-panel
      h2 了解更多
      .cta-row
        button.small.inverted(data-goto='/tutorial') 完整规则与教程 →
        button.small(data-goto='/develop') 参与网站开发 →
        button.small(data-goto='/develop/bot') 机器人开发协议 →
        button.small(data-goto='/ambassadors') 推广大使感谢墙 →
    section.doc-panel
      h2 Star 支持
      p 绑定 GitHub 并 Star Roka 后，经核验的全站公共用户名组件都会将名字首字母显示为金色，包括排行榜、动态与评论、房间与聊天、对局及回放榜单和个人主页。其余字符仍保留原有 Rating、封禁、管理员或局内配色；未 Star、状态未知或核验过期时不显示金色，可在个人主页刷新状态。
      a.doc-link(
        href='https://github.com/oimasterkafuu/Roka',
        target='_blank',
        rel='noopener noreferrer'
      ) 前往 GitHub 为 Roka 点 Star →
    section.doc-panel(aria-labelledby='contributors-title')
      h2#contributors-title 项目贡献者
      p 感谢每一位为 Roka 提交代码、完善项目的贡献者。
      p#contributors-status(role='status') 正在加载贡献者名单…
      #contributors-grid.contributors-grid
      p.contributors-github-link
        | 也可以在 GitHub 查看 
        a.doc-link(
          href='https://github.com/oimasterkafuu/Roka/graphs/contributors',
          target='_blank',
          rel='noopener noreferrer'
        ) Contributors 完整名单
        | 。
    section.doc-panel(aria-labelledby='stargazers-title')
      h2#stargazers-title Star 支持者
      p 感谢每一位在 GitHub 为 Roka 点亮 Star 的支持者。
      p#stargazers-status(role='status') 正在加载 Star 支持者名单…
      #stargazers-grid.contributors-grid
    section.doc-panel
      h2 来源与参考
      p 以下信息用于致谢与许可证合规说明，便于追溯核心玩法、实现参考和协议来源。
      table.doc-table.doc-table-narrow
        tr
          th 项目源码
          td
            | oimasterkafuu / Roka
            br
            a.doc-link(
              href='https://github.com/oimasterkafuu/Roka',
              target='_blank',
              rel='noopener noreferrer'
            ) https://github.com/oimasterkafuu/Roka
          td AGPL-3.0
        tr
          th 原始玩法
          td
            | generals.io
            br
            a.doc-link(href='https://generals.io/', target='_blank', rel='noopener noreferrer') https://generals.io/
          td Closed-source
        tr
          th 玩法参考
          td
            | Konkr.io
            br
            a.doc-link(href='https://konkr.io/', target='_blank', rel='noopener noreferrer') https://konkr.io/
          td Closed-source
        tr
          th 复刻基础
          td
            | mcfx0 / generals.io_copy
            br
            a.doc-link(
              href='https://github.com/mcfx/generals.io_copy',
              target='_blank',
              rel='noopener noreferrer'
            ) https://github.com/mcfx/generals.io_copy
          td BSD 3-Clause License
        tr
          th 灵感启发
          td
            | By-Ha / Checkmate
            br
            a.doc-link(
              href='https://github.com/By-Ha/Checkmate',
              target='_blank',
              rel='noopener noreferrer'
            ) https://github.com/By-Ha/Checkmate
          td MIT License
        tr
          th 代码基础
          td
            | oimasterkafuu / checkmate
            br
            a.doc-link(
              href='https://github.com/oimasterkafuu/checkmate',
              target='_blank',
              rel='noopener noreferrer'
            ) https://github.com/oimasterkafuu/checkmate
          td AGPL-3.0

block scripts
  script(src='/docs.js?v={{V}}')
  script(src='/about-contributors.js?v={{V}}')
