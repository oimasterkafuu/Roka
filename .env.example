# Existing secrets are generated automatically on first boot when left unset.
JWT_SECRET=
WEBHOOK_SECRET=

# GitHub OAuth App credentials. Binding is disabled until all three are configured.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://roka.example.com/api/auth/github/callback

# Token used only for the full repository stargazer list. Anonymous sync works with a lower rate limit.
GITHUB_STARGAZERS_TOKEN=

# Local mock tests only; leave unset in production.
# GITHUB_OAUTH_BASE_URL=http://127.0.0.1:18080
# GITHUB_API_BASE_URL=http://127.0.0.1:18080
